        <mxCell id="title" value="&lt;b&gt;Meta-Harness：AscendC 算子编译优化外循环系统&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=18;fontColor=#1a237e;" parent="1" vertex="1">
          <mxGeometry x="380" y="10" width="520" height="35" as="geometry"/>
        </mxCell>

        <!-- ================================================================ -->
