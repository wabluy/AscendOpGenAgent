        <mxCell id="outer_label" value="&lt;b&gt;外循环（新增）&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=14;fontColor=#1565c0;" parent="1" vertex="1">
