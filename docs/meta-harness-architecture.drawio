        <!-- T6 badge -->
        <mxCell id="t6_badge" value="&lt;b&gt;T6&lt;/b&gt; 零侵入，只替换静态配置文件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b2dfdb;strokeColor=#00695c;fontSize=9;arcSize=20;fontColor=#004d40;" parent="1" vertex="1">
