        <!-- Step 0: Register Baseline -->
        <mxCell id="s0" value="⓪ 注册基线 Harness&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666&quot;&gt;快照当前 Skills 配置文件到 DB&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;fontSize=11;arcSize=15;" parent="outer_container" vertex="1">
          <mxGeometry x="230" y="40" width="220" height="50" as="geometry"/>
        </mxCell>

        <!-- Step 1: Export Context -->
        <mxCell id="s1" value="① 导出搜索上下文&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666&quot;&gt;Harness 排名 / 错误统计 / Trace&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;fontSize=11;arcSize=15;" parent="outer_container" vertex="1">
          <mxGeometry x="20" y="130" width="220" height="50" as="geometry"/>
        </mxCell>

        <!-- Step 2: Proposer -->
        <mxCell id="s2" value="② Proposer Agent 分析&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666&quot;&gt;检索历史 Trace → 识别失败模式 → 提出改进&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#90caf9;strokeColor=#1565c0;fontSize=11;arcSize=15;fontStyle=1;" parent="outer_container" vertex="1">
          <mxGeometry x="20" y="220" width="280" height="55" as="geometry"/>
        </mxCell>

        <!-- Step 3: Generate Variant -->
        <mxCell id="s3" value="③ 生成 Harness 变体&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666&quot;&gt;修改 SKILL.md / error_correction / 模板&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;fontSize=11;arcSize=15;" parent="outer_container" vertex="1">
          <mxGeometry x="20" y="315" width="220" height="50" as="geometry"/>
        </mxCell>

        <!-- Step 4: Backup + Apply -->
        <mxCell id="s4" value="④ 备份当前配置 → 应用变体" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;fontSize=11;arcSize=15;" parent="outer_container" vertex="1">
          <mxGeometry x="20" y="405" width="220" height="40" as="geometry"/>
        </mxCell>

        <!-- Step 5: Evaluate -->
        <mxCell id="s5" value="⑤ 在 L2 搜索集上评估&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666&quot;&gt;调用现有 Pipeline 完整执行 (含内循环重试)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#90caf9;strokeColor=#1565c0;fontSize=11;arcSize=15;fontStyle=1;" parent="outer_container" vertex="1">
          <mxGeometry x="290" y="405" width="260" height="50" as="geometry"/>
        </mxCell>

        <!-- Step 6: Collect Traces -->
        <mxCell id="s6" value="⑥ 收集编译 Trace 入库&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666&quot;&gt;pass×attempt 粒度，保留完整编译器输出&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;fontSize=11;arcSize=15;" parent="outer_container" vertex="1">
          <mxGeometry x="380" y="315" width="260" height="50" as="geometry"/>
        </mxCell>

        <!-- Step 7: Restore -->
        <mxCell id="s7" value="⑦ 恢复原始配置" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;fontSize=11;arcSize=15;" parent="outer_container" vertex="1">
          <mxGeometry x="440" y="220" width="180" height="40" as="geometry"/>
        </mxCell>

        <!-- Step 8: Pareto -->
        <mxCell id="s8" value="⑧ 更新 Pareto 前沿" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;fontSize=11;arcSize=15;" parent="outer_container" vertex="1">
          <mxGeometry x="440" y="130" width="180" height="40" as="geometry"/>
