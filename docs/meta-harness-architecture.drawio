        <!-- ================================================================ -->
        <!-- STEP 1: EXPORT CONTEXT FROM DB                                    -->
        <!-- ================================================================ -->
        <mxCell id="s1" value="&lt;b&gt;① 从数据库导出搜索上下文&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;查询历史 Harness 的编译通过率排名、&lt;br&gt;各 Pass 失败率统计、最难任务排行&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#90caf9;strokeColor=#1565c0;fontSize=12;arcSize=10;shadow=1;" parent="1" vertex="1">
          <mxGeometry x="60" y="110" width="310" height="70" as="geometry"/>
        </mxCell>
        <!-- T2 badge -->
        <mxCell id="t2_badge" value="&lt;b&gt;T2&lt;/b&gt; 按需检索，不全量注入 Context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b2dfdb;strokeColor=#00695c;fontSize=9;arcSize=20;fontColor=#004d40;" parent="1" vertex="1">
          <mxGeometry x="385" y="110" width="210" height="26" as="geometry"/>
        </mxCell>

        <!-- ================================================================ -->
        <!-- STEP 2: PROPOSER ANALYZES                                         -->
        <!-- ================================================================ -->
        <mxCell id="s2" value="&lt;b&gt;② Proposer Agent 分析失败模式&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;从数据库中检索编译失败的完整编译器日志，&lt;br&gt;识别高频错误类型，定位最薄弱的 Lowering Pass&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#90caf9;strokeColor=#1565c0;fontSize=12;arcSize=10;shadow=1;" parent="1" vertex="1">
          <mxGeometry x="60" y="210" width="310" height="75" as="geometry"/>
        </mxCell>
        <!-- T1 badge -->
        <mxCell id="t1_badge" value="&lt;b&gt;T1&lt;/b&gt; 完整 Trace 保留，不压缩摘要" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b2dfdb;strokeColor=#00695c;fontSize=9;arcSize=20;fontColor=#004d40;" parent="1" vertex="1">
          <mxGeometry x="385" y="210" width="210" height="26" as="geometry"/>
        </mxCell>
        <!-- T4 badge -->
        <mxCell id="t4_badge" value="&lt;b&gt;T4&lt;/b&gt; 跨任务错误模式自动发现" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b2dfdb;strokeColor=#00695c;fontSize=9;arcSize=20;fontColor=#004d40;" parent="1" vertex="1">
          <mxGeometry x="385" y="245" width="210" height="26" as="geometry"/>
        </mxCell>

        <!-- ================================================================ -->
        <!-- STEP 3: GENERATE VARIANT                                          -->
        <!-- ================================================================ -->
        <mxCell id="s3" value="&lt;b&gt;③ 生成新的 Harness 配置变体&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;修改 dsl-lowering 的 Prompt 指令（控制 4 个 Pass 如何生成代码），&lt;br&gt;扩充编译错误修复规则（当前仅 3 条），&lt;br&gt;调整 Lowering 参考代码模板的选择策略&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ce93d8;strokeColor=#7b1fa2;fontSize=12;arcSize=10;fontColor=#4a148c;shadow=1;" parent="1" vertex="1">
          <mxGeometry x="60" y="320" width="340" height="85" as="geometry"/>
        </mxCell>
        <!-- T3 badge -->
        <mxCell id="t3_badge" value="&lt;b&gt;T3&lt;/b&gt; 版本化存储 + 血统追溯 + Diff" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b2dfdb;strokeColor=#00695c;fontSize=9;arcSize=20;fontColor=#004d40;" parent="1" vertex="1">
          <mxGeometry x="415" y="325" width="210" height="26" as="geometry"/>
        </mxCell>

        <!-- ================================================================ -->
