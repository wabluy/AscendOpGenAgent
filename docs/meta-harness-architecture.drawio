        </mxCell>

        <!-- ================================================================ -->
        <!-- SECTION: KEY TECH INNOVATIONS (RIGHT)                             -->
        <!-- ================================================================ -->
        <mxCell id="tech_container" value="&lt;b&gt;核心技术创新&lt;/b&gt;" style="swimlane;startSize=24;fillColor=#e0f2f1;strokeColor=#00695c;fontColor=#00695c;fontSize=11;rounded=1;arcSize=8;collapsible=0;" parent="1" vertex="1">
          <mxGeometry x="1040" y="160" width="520" height="480" as="geometry"/>
        </mxCell>

        <mxCell id="t1" value="&lt;b&gt;T1 完整 Trace 保留&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;保留完整编译器输出（行号+错误码+代码上下文）&lt;br&gt;不做摘要压缩，由 Proposer 按需检索&lt;br&gt;论文消融实验证明完整 Trace 比摘要提升 +15pt&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b2dfdb;strokeColor=#00695c;fontSize=10;arcSize=10;align=left;spacingLeft=8;" parent="tech_container" vertex="1">
          <mxGeometry x="15" y="34" width="490" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="&lt;b&gt;T2 文件系统式历史访问&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Proposer 通过 DB 查询检索历史（非全量注入 Context）&lt;br&gt;支持 grep/filter 式按需获取，突破 Context 窗口限制&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b2dfdb;strokeColor=#00695c;fontSize=10;arcSize=10;align=left;spacingLeft=8;" parent="tech_container" vertex="1">
          <mxGeometry x="15" y="104" width="490" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;T3 Harness 版本化 + Diff&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;每个变体的所有配置文件快照存入 DB，支持任意两版本 Diff&lt;br&gt;parent_id 链追溯优化血统，精确归因哪个改动导致了效果变化&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b2dfdb;strokeColor=#00695c;fontSize=10;arcSize=10;align=left;spacingLeft=8;" parent="tech_container" vertex="1">
          <mxGeometry x="15" y="168" width="490" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="t4" value="&lt;b&gt;T4 自动错误模式发现&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;error_category 自动聚类，按 pass 统计失败率&lt;br&gt;跨任务、跨版本分析最顽固错误 → 指导 Proposer 针对性优化&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b2dfdb;strokeColor=#00695c;fontSize=10;arcSize=10;align=left;spacingLeft=8;" parent="tech_container" vertex="1">
          <mxGeometry x="15" y="232" width="490" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="t5" value="&lt;b&gt;T5 多目标 Pareto 搜索&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;同时优化编译通过率 + 精度通过率 + 性能加速比&lt;br&gt;自动维护 Pareto 前沿，输出一组非支配最优 Harness&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b2dfdb;strokeColor=#00695c;fontSize=10;arcSize=10;align=left;spacingLeft=8;" parent="tech_container" vertex="1">
          <mxGeometry x="15" y="296" width="490" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="t6" value="&lt;b&gt;T6 零侵入集成&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;只替换静态配置文件，不修改 Pipeline 执行逻辑&lt;br&gt;评估前备份→评估后恢复，完全可逆&lt;br&gt;最终产出直接 cp 到 skills/ 目录即可部署&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b2dfdb;strokeColor=#00695c;fontSize=10;arcSize=10;align=left;spacingLeft=8;" parent="tech_container" vertex="1">
          <mxGeometry x="15" y="360" width="490" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="t7" value="&lt;b&gt;T7 编译验证秒级反馈&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;编译检查无需 NPU 运行时，单任务评估 &amp;lt;1min&lt;br&gt;同等时间可评估数倍于论文其他场景的候选数量&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b2dfdb;strokeColor=#00695c;fontSize=10;arcSize=10;align=left;spacingLeft=8;" parent="tech_container" vertex="1">
          <mxGeometry x="15" y="430" width="490" height="44" as="geometry"/>
        </mxCell>

